# Supabase (crear proyecto en https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mobile (Expo) — mismas credenciales con prefijo EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vercel (admin panel)
# Configurar NEXT_PUBLIC_SUPABASE_* en el dashboard de Vercel
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_PROJECT_REF=your-project-ref
# Optional: defaults to aws-1-us-east-1.pooler.supabase.com:6543
# SUPABASE_POOLER_HOST=aws-1-us-east-1.pooler.supabase.com
# SUPABASE_POOLER_PORT=6543

# Cron diario (Finanzas: mora, recargos, saldos, recordatorios)
CRON_SECRET=generate-a-long-random-string

# Recordatorios por correo (Resend — https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Veka <recordatorios@vekacondo.com>

# Pagos (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=https://tu-admin.vercel.app

# CFDI México (deshabilitado por defecto — activar cuando tengas datos fiscales y Facturapi)
# CFDI_BILLING_ENABLED=true
# NEXT_PUBLIC_CFDI_BILLING_ENABLED=true
# FACTURAPI_API_KEY=

# Mobile — URL del panel admin para checkout Stripe
EXPO_PUBLIC_ADMIN_URL=https://tu-admin.vercel.app
