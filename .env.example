# Supabase (crear proyecto en https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mobile (Expo) — mismas credenciales con prefijo EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor / Edge Functions — NUNCA en la app móvil
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel (admin panel)
# Configurar NEXT_PUBLIC_SUPABASE_* en el dashboard de Vercel

# Pagos (fase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
