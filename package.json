{
  "name": "veka",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:mobile": "node scripts/start-expo-go.mjs",
    "dev:mobile:tunnel": "node scripts/start-expo-go.mjs --tunnel",
    "dev:mobile:warm": "node scripts/warm-expo-bundle.mjs",
    "dev:mobile:url": "npm run dev:url --workspace=@veka/mobile",
    "build:mobile:dev:ios": "npm run eas:build:dev:ios --workspace=@veka/mobile",
    "build:mobile:dev:android": "npm run eas:build:dev:android --workspace=@veka/mobile",
    "dev:admin": "npm run dev --workspace=@veka/admin",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:shared": "npm run test --workspace=@veka/shared",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:types": "supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "setup:supabase": "bash scripts/setup-supabase.sh",
    "create:supabase": "bash scripts/create-supabase-project.sh",
    "link:supabase": "bash scripts/link-supabase-project.sh",
    "setup:image-storage": "node scripts/setup-image-storage.mjs",
    "seed:amenity-images": "node scripts/seed-amenity-demo-images.mjs",
    "seed:amenity-rules": "node scripts/seed-amenity-rules.mjs",
    "seed:pilot-demo": "node scripts/seed-pilot-demo.mjs",
    "seed:pilot-finance": "node scripts/seed-pilot-finance.mjs",
    "apply:reservation-rpc": "node scripts/apply-reservation-rpc.mjs",
    "apply:condo-transparency-income": "node scripts/apply-condo-transparency-income.mjs",
    "apply:condo-transparency-collection": "node scripts/apply-condo-transparency-collection.mjs",
    "apply:community-features": "node scripts/apply-community-features.mjs",
    "apply:community-comments-poll-close": "node scripts/apply-community-comments-poll-close.mjs",
    "apply:community-moderation-quorum-notifications": "node scripts/apply-community-moderation-quorum-notifications.mjs",
    "apply:community-cluster-targeting": "node scripts/apply-community-cluster-targeting.mjs",
    "apply:maintenance-routines": "node scripts/apply-maintenance-routines.mjs",
    "apply:maintenance-routine-evidence": "node scripts/apply-maintenance-routine-evidence.mjs",
    "apply:profiles-condo-members-select": "node scripts/apply-profiles-condo-members-select.mjs",
    "verify:condo-transparency": "node scripts/verify-condo-transparency.mjs"
  },
  "devDependencies": {
    "postgres": "^3.4.7",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2"
}
